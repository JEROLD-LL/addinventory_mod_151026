{
  "openapi": "3.0.3",
  "info": {
    "title": "Add Inventory API",
    "description": "API endpoints for the Add Inventory application - Part Catalog Management",
    "termsOfService": "https://example.com/terms",
    "contact": {
      "name": "Add Inventory Support",
      "url": "https://example.com/support",
      "email": "support@example.com"
    },
