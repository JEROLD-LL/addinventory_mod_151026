      "name": "Proprietary",
      "url": "https://example.com/license"
    },
    "version": "1.0.0"
  },
  "externalDocs": {
    "description": "Add Inventory Application Documentation",
    "url": "https://example.com/docs"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production server",
      "variables": {
        "basePath": {
          "default": "/v1",
          "description": "API base path"
        }
      }
    },
    {
      "url": "https://staging-api.example.com/v1",
      "description": "Staging server"
    }
  ],
  "tags": [
    {
      "name": "Parts",
      "description": "Part catalog and search operations",
      "externalDocs": {
        "description": "Parts API documentation",
        "url": "https://example.com/docs/parts"
      }
    }
  ],
  "paths": {
    "/parts/search": {
      "summary": "Search Part Catalog",
      "description": "Searches the part catalog by part number and retrieves the part description from the IFS database",
      "get": {
        "tags": [
          "Parts"
        ],
        "summary": "Search Part Catalog by Part Number",
        "description": "Searches for a part in the catalog using the provided part number and returns the part description. This endpoint queries the IFS.search_part_description_by_partno stored procedure to retrieve part information.",
        "operationId": "SearchPartCatalog(AddInventory-main.Add Inventory.Forms.frmMainPartMaintenance.frmMainPartMaintenance.SearchPartCatalog.0)",
        "parameters": [
          {
            "name": "partno",
            "in": "query",
            "description": "The part number to search for in the catalog",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "example": "PART-12345"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the part description from the catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "partNumber": {
                      "type": "string",
                      "description": "The part number that was searched",
                      "example": "PART-12345"
                    },
                    "partDescription": {
                      "type": "string",
                      "description": "The description of the part retrieved from the catalog",
                      "example": "Industrial Grade Widget Assembly"
                    },
                    "found": {
                      "type": "boolean",
                      "description": "Indicates whether the part was found in the catalog",
                      "example": true
                    }
                  },
                  "required": [
                    "partNumber",
                    "found"
                  ]
                },
                "example": {
                  "partNumber": "PART-12345",
                  "partDescription": "Industrial Grade Widget Assembly",
                  "found": true
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid or missing part number parameter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message describing the validation failure"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 400
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 401
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - User does not have permission to access this resource",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 403
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Part number not found in the catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "partNumber": {
                      "type": "string",
                      "description": "The part number that was searched"
                    },
                    "found": {
                      "type": "boolean",
                      "description": "Indicates the part was not found",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message indicating part not found"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 404
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Database connection failure or query execution error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message describing the database or server error"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 500
                    },
                    "details": {
                      "type": "string",
                      "description": "Additional error details for debugging"
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PartSearchResponse": {
        "type": "object",
        "description": "Part search response object containing part information",
        "properties": {
          "partNumber": {
            "type": "string",
            "description": "The part number that was searched",
            "example": "PART-12345"
          },
          "partDescription": {
            "type": "string",
            "description": "The description of the part",
            "example": "Industrial Grade Widget Assembly"
          },
          "found": {
            "type": "boolean",
            "description": "Indicates whether the part was found",
            "example": true
          }
        },
        "required": [
          "partNumber",
          "found"
        ]
      },
      "PartNotFoundResponse": {
        "type": "object",
        "description": "Response when part is not found in the catalog",
        "properties": {
          "partNumber": {
            "type": "string",
            "description": "The part number that was searched"
          },
          "found": {
            "type": "boolean",
            "description": "Indicates the part was not found",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "statusCode": {
            "type": "integer",
            "example": 404
          }
        },
        "required": [
          "partNumber",
          "found",
          "error",
          "statusCode"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "statusCode": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "details": {
            "type": "string",
            "description": "Additional error details"
          }
        },
        "required": [
          "error",
          "statusCode"
        ]
      }
    },
    "responses": {
      "PartSearchSuccessResponse": {
        "description": "Successfully retrieved part information",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PartSearchResponse"
            }
          }
        }
      },
      "PartNotFoundResponse": {
        "description": "Part not found in catalog",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PartNotFoundResponse"
            }
          }
        }
      },
      "BadRequestError": {
        "description": "Bad request - Invalid parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnauthorizedError": {
        "description": "Unauthorized - Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "Forbidden - User does not have permission",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
