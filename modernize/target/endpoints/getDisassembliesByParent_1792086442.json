    },
    "version": "1.0.0"
  },
  "externalDocs": {
    "description": "Find more information about the Add Inventory system",
    "url": "https://example.com/docs"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production server",
      "variables": {
        "basePath": {
          "default": "/inventory",
          "description": "Base path for inventory operations"
        }
      }
    },
    {
      "url": "https://staging-api.example.com/v1",
      "description": "Staging server"
    }
