{
  "openapi": "3.0.3",
  "info": {
    "title": "Add Inventory - Utilization Tool API",
    "description": "API for launching the utilization analysis tool with optional part number and warehouse parameters. This endpoint manages the execution of the utilization.exe process with dynamically retrieved warehouse information.",
    "termsOfService": "https://example.com/terms",
    "contact": {
      "name": "Add Inventory Support",
      "url": "https://example.com/support",
      "email": "support@example.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://example.com/license"
    },
    "version": "1.0.0"
  },
  "externalDocs": {
    "description": "Utilization Tool Documentation",
    "url": "https://example.com/docs/utilization"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production Server",
      "variables": {}
    },
    {
      "url": "https://staging-api.example.com/v1",
      "description": "Staging Server",
      "variables": {}
    }
  ],
  "tags": [
    {
      "name": "Utilization",
      "description": "Operations related to the utilization analysis tool",
      "externalDocs": {
        "description": "Utilization Tool External Documentation",
        "url": "https://example.com/docs/utilization-tool"
      }
    }
  ],
  "paths": {
    "/utilization/launch": {
      "summary": "Launch Utilization Analysis Tool",
      "description": "Initiates the utilization.exe process with optional part number and automatically retrieved warehouse information. If a part number is provided, the tool will analyze utilization for that specific part in the default warehouse.",
      "post": {
        "tags": [
          "Utilization"
        ],
        "summary": "Launch the utilization analysis tool",
        "description": "Launches the utilization.exe external process. If a part number is provided and not empty, the process will be started with warehouse and part number parameters. The warehouse code is automatically retrieved from the database (default warehouse). If the process is already running, it will be brought to the foreground.",
        "operationId": "launchUtilization[AddInventory-main.Add Inventory.Forms.frmAddInventory.frmAddInventory.UtilizationToolStripMenuItem_Click.2.Object.EventArgs]",
        "parameters": [
          {
            "name": "partNumber",
            "in": "query",
            "description": "The part number to analyze in the utilization tool. If not provided or empty, the tool will launch without part-specific parameters.",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 0,
              "maxLength": 50,
              "nullable": true,
              "example": "PART-12345"
            },
            "example": "PART-12345"
          }
        ],
        "responses": {
          "200": {
            "description": "Utilization tool process launched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success",
                        "already_running"
                      ],
                      "description": "Status of the process launch operation",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "description": "Descriptive message about the operation result",
                      "example": "Utilization tool launched successfully"
                    },
                    "processId": {
                      "type": "integer",
                      "format": "int32",
                      "nullable": true,
                      "description": "Process ID of the launched utilization.exe, null if process was already running",
                      "example": 12345
                    },
                    "warehouseCode": {
                      "type": "string",
                      "description": "The default warehouse code used for the process",
                      "example": "WH001"
                    },
                    "partNumber": {
                      "type": "string",
                      "nullable": true,
                      "description": "The part number passed to the process, null if not provided",
                      "example": "PART-12345"
                    },
                    "commandArguments": {
                      "type": "string",
                      "description": "The command line arguments passed to utilization.exe",
                      "example": "bld=WH001 partno=PART-12345"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO 8601 timestamp of when the process was launched",
                      "example": "2024-01-15T10:30:00Z"
                    }
                  },
                  "required": [
                    "status",
                    "message",
                    "warehouseCode",
                    "commandArguments",
                    "timestamp"
                  ]
                },
                "example": {
                  "status": "success",
                  "message": "Utilization tool launched successfully",
                  "processId": 12345,
                  "warehouseCode": "WH001",
                  "partNumber": "PART-12345",
                  "commandArguments": "bld=WH001 partno=PART-12345",
                  "timestamp": "2024-01-15T10:30:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ],
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "description": "Error message describing what went wrong",
                      "example": "Invalid part number format"
                    },
                    "errorCode": {
                      "type": "string",
                      "description": "Machine-readable error code",
                      "example": "INVALID_PART_NUMBER"
                    },
                    "details": {
                      "type": "object",
                      "nullable": true,
                      "description": "Additional error details",
                      "example": {
                        "field": "partNumber",
                        "reason": "Part number exceeds maximum length"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "message",
                    "errorCode"
                  ]
                },
                "example": {
                  "status": "error",
                  "message": "Invalid part number format",
                  "errorCode": "INVALID_PART_NUMBER",
                  "details": {
                    "field": "partNumber",
                    "reason": "Part number exceeds maximum length"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ],
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Authentication required"
                    },
                    "errorCode": {
                      "type": "string",
                      "example": "UNAUTHORIZED"
                    }
                  },
                  "required": [
                    "status",
                    "message",
                    "errorCode"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - user does not have permission to launch utilization tool",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ],
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Insufficient permissions to launch utilization tool"
                    },
                    "errorCode": {
                      "type": "string",
                      "example": "FORBIDDEN"
                    }
                  },
                  "required": [
                    "status",
                    "message",
                    "errorCode"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error - database connection failure, process launch failure, or other server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ],
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "description": "Error message describing the server error",
                      "example": "Failed to retrieve warehouse information from database"
                    },
                    "errorCode": {
                      "type": "string",
                      "description": "Machine-readable error code",
                      "example": "DATABASE_ERROR"
                    },
                    "details": {
                      "type": "object",
                      "nullable": true,
                      "description": "Additional error details for debugging",
                      "example": {
                        "reason": "No default warehouse found in database",
                        "timestamp": "2024-01-15T10:30:00Z"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "message",
                    "errorCode"
                  ]
                },
                "example": {
                  "status": "error",
                  "message": "Failed to retrieve warehouse information from database",
                  "errorCode": "DATABASE_ERROR",
                  "details": {
                    "reason": "No default warehouse found in database",
                    "timestamp": "2024-01-15T10:30:00Z"
                  }
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UtilizationLaunchRequest": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "string",
            "nullable": true,
            "minLength": 0,
            "maxLength": 50,
            "description": "Optional part number to analyze",
            "example": "PART-12345"
          }
        }
      },
      "UtilizationLaunchResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "already_running"
            ],
            "description": "Status of the process launch",
            "example": "success"
          },
          "message": {
            "type": "string",
            "description": "Descriptive message",
            "example": "Utilization tool launched successfully"
          },
          "processId": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "Process ID if newly launched",
            "example": 12345
          },
          "warehouseCode": {
            "type": "string",
            "description": "Default warehouse code",
            "example": "WH001"
          },
          "partNumber": {
            "type": "string",
            "nullable": true,
            "description": "Part number used",
            "example": "PART-12345"
          },
          "commandArguments": {
            "type": "string",
            "description": "Command line arguments",
            "example": "bld=WH001 partno=PART-12345"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Launch timestamp",
            "example": "2024-01-15T10:30:00Z"
          }
        },
        "required": [
          "status",
          "message",
          "warehouseCode",
          "commandArguments",
          "timestamp"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ],
            "example": "error"
          },
          "message": {
            "type": "string",
            "description": "Error message",
            "example": "An error occurred"
          },
          "errorCode": {
            "type": "string",
            "description": "Error code",
            "example": "INTERNAL_ERROR"
          },
          "details": {
            "type": "object",
            "nullable": true,
            "description": "Additional details",
            "example": {}
          }
        },
        "required": [
          "status",
          "message",
          "errorCode"
        ]
      }
    },
    "responses": {
      "UtilizationLaunchSuccess": {
        "description": "Utilization tool launched successfully",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UtilizationLaunchResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad request error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
