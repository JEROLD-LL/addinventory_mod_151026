{
  "openapi": "3.0.3",
  "info": {
    "title": "Add Inventory - Barcode Preview API",
    "description": "API for managing barcode preview generation and navigation in the Add Inventory application. This endpoint handles navigation through barcode items and generates preview images using the Labelary API.",
    "termsOfService": "https://example.com/terms",
    "contact": {
      "name": "IT Support",
      "url": "https://example.com/support",
      "email": "support@example.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://example.com/license"
    },
    "version": "1.0.0"
  },
  "externalDocs": {
    "description": "Labelary API Documentation - ZPL Label Preview Service",
    "url": "http://api.labelary.com/docs"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production API Server",
      "variables": {
        "basePath": {
          "default": "/v1",
          "description": "API version path"
        }
      }
    },
    {
      "url": "http://localhost:5000/v1",
      "description": "Development API Server"
    }
  ],
  "tags": [
    {
      "name": "Barcode Preview",
      "description": "Operations for barcode preview generation and navigation",
      "externalDocs": {
        "description": "Barcode Preview Operations Documentation",
        "url": "https://example.com/docs/barcode-preview"
      }
    }
  ],
  "paths": {
    "/barcode-preview/navigate-previous": {
      "summary": "Navigate to previous barcode and generate preview",
      "description": "Navigates to the previous barcode in the list and generates a preview image. If currently at the first barcode, wraps around to the last item. The preview is generated by sending ZPL (Zebra Programming Language) data to the Labelary API.",
      "post": {
        "tags": [
          "Barcode Preview"
        ],
        "summary": "Navigate to previous barcode and display preview",
        "description": "This endpoint handles the navigation to the previous barcode item in a collection and generates a preview image of the barcode label. It implements circular navigation - when at the first item, it wraps to the last item. The barcode data is converted to ZPL format using the selected template, then sent to the Labelary API to generate a preview image.",
        "operationId": "previewPreviousBarcode[Add Inventory.Forms.frmPrintZPLDialog.frmPrintZPLDialog.btnPreviewPrevBarcode_Click.2.Object.EventArgs]",
        "requestBody": {
          "description": "Request payload containing barcode items, current selection index, and barcode template information",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "barcodeItems",
                  "currentBarcodeIndex",
                  "barcodeTemplate"
                ],
                "properties": {
                  "barcodeItems": {
                    "type": "array",
                    "description": "Array of barcode items to print. Each item contains barcode and serial number information.",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "barcode",
                        "serialNumber"
                      ],
                      "properties": {
                        "barcode": {
                          "type": "string",
                          "description": "The barcode value/identifier",
                          "example": "BC123456789"
                        },
                        "serialNumber": {
                          "type": "string",
                          "description": "The serial number associated with the barcode",
                          "example": "SN-2024-001"
                        }
                      }
                    }
                  },
                  "currentBarcodeIndex": {
                    "type": "integer",
                    "description": "The current index of the selected barcode in the barcodeItems array (0-based)",
                    "minimum": 0,
                    "example": 2
                  },
                  "barcodeTemplate": {
                    "type": "object",
                    "description": "The barcode template configuration containing ZPL template data and calibration offsets",
                    "required": [
                      "name",
                      "templatePath",
                      "xOffset",
                      "yOffset"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Name of the barcode template",
                        "example": "Standard Label Template"
                      },
                      "templatePath": {
                        "type": "string",
                        "description": "File path to the ZPL template file",
                        "example": "/templates/barcode_template.zpl"
                      },
                      "xOffset": {
                        "type": "number",
                        "format": "double",
                        "description": "X-axis calibration offset in inches",
                        "example": 0.0
                      },
                      "yOffset": {
                        "type": "number",
                        "format": "double",
                        "description": "Y-axis calibration offset in inches",
                        "example": 0.0
                      }
                    }
                  }
                }
              },
              "example": {
                "barcodeItems": [
                  {
                    "barcode": "BC001",
                    "serialNumber": "SN-2024-001"
                  },
                  {
                    "barcode": "BC002",
                    "serialNumber": "SN-2024-002"
                  },
                  {
                    "barcode": "BC003",
                    "serialNumber": "SN-2024-003"
                  }
                ],
                "currentBarcodeIndex": 2,
                "barcodeTemplate": {
                  "name": "Standard Label",
                  "templatePath": "/templates/standard_label.zpl",
                  "xOffset": 0.0,
                  "yOffset": 0.0
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Barcode preview generated successfully. Returns the preview image and navigation information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates whether the preview generation was successful",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "description": "Success message describing the operation",
                      "example": "Barcode preview generated successfully"
                    },
                    "selectedBarcodeIndex": {
                      "type": "integer",
                      "description": "The index of the newly selected barcode (after navigation)",
                      "example": 1
                    },
                    "selectedBarcode": {
                      "type": "object",
                      "description": "Details of the currently selected barcode",
                      "properties": {
                        "barcode": {
                          "type": "string",
                          "description": "The barcode value",
                          "example": "BC002"
                        },
                        "serialNumber": {
                          "type": "string",
                          "description": "The serial number",
                          "example": "SN-2024-002"
                        }
                      }
                    },
                    "previewImage": {
                      "type": "string",
                      "format": "byte",
                      "description": "Base64-encoded preview image of the barcode label (PNG format)",
                      "example": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
                    },
                    "previewImageMimeType": {
                      "type": "string",
                      "description": "MIME type of the preview image",
                      "example": "image/png"
                    },
                    "navigationInfo": {
                      "type": "object",
                      "description": "Information about the navigation operation",
                      "properties": {
                        "totalItems": {
                          "type": "integer",
                          "description": "Total number of barcode items in the collection",
                          "example": 3
                        },
                        "previousIndex": {
                          "type": "integer",
                          "description": "The index before navigation",
                          "example": 2
                        },
                        "currentIndex": {
                          "type": "integer",
                          "description": "The index after navigation",
                          "example": 1
                        },
                        "isWrapped": {
                          "type": "boolean",
                          "description": "Indicates if navigation wrapped around (from first to last item)",
                          "example": false
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Barcode preview generated successfully",
                  "selectedBarcodeIndex": 1,
                  "selectedBarcode": {
                    "barcode": "BC002",
                    "serialNumber": "SN-2024-002"
                  },
                  "previewImage": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
                  "previewImageMimeType": "image/png",
                  "navigationInfo": {
                    "totalItems": 3,
                    "previousIndex": 2,
                    "currentIndex": 1,
                    "isWrapped": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Invalid input parameters or missing required fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message describing what went wrong",
                      "example": "Invalid request: barcodeItems array is empty"
                    },
                    "errorCode": {
                      "type": "string",
                      "description": "Error code for programmatic handling",
                      "example": "INVALID_INPUT"
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": "Invalid request: currentBarcodeIndex out of range",
                  "errorCode": "INVALID_INPUT"
                }
              }
            }
          },
          "404": {
            "description": "Template not found or barcode data not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message",
                      "example": "Barcode template file not found"
                    },
                    "errorCode": {
                      "type": "string",
                      "example": "TEMPLATE_NOT_FOUND"
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": "Barcode template file not found at path: /templates/standard_label.zpl",
                  "errorCode": "TEMPLATE_NOT_FOUND"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error. Failed to generate preview or communicate with Labelary API.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message describing the server error",
                      "example": "Failed to generate preview: Connection to Labelary API failed"
                    },
                    "errorCode": {
                      "type": "string",
                      "description": "Error code for programmatic handling",
                      "example": "PREVIEW_GENERATION_FAILED"
                    },
                    "details": {
                      "type": "string",
                      "description": "Additional error details for debugging",
                      "example": "HTTP 503 Service Unavailable from http://api.labelary.com/v1/printers/12dpmm/labels/1x.5/0/"
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": "Failed to generate preview: Connection to Labelary API failed",
                  "errorCode": "PREVIEW_GENERATION_FAILED",
                  "details": "HTTP 503 Service Unavailable from http://api.labelary.com/v1/printers/12dpmm/labels/1x.5/0/"
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "BarcodeItem": {
        "type": "object",
        "description": "Represents a single barcode item to be printed",
        "required": [
          "barcode",
          "serialNumber"
        ],
        "properties": {
          "barcode": {
            "type": "string",
            "description": "The barcode value/identifier",
            "example": "BC123456789"
          },
          "serialNumber": {
            "type": "string",
            "description": "The serial number associated with the barcode",
            "example": "SN-2024-001"
          }
        }
      },
      "BarcodeTemplate": {
        "type": "object",
        "description": "Configuration for barcode template with ZPL data and calibration settings",
        "required": [
          "name",
          "templatePath",
          "xOffset",
          "yOffset"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the barcode template",
            "example": "Standard Label Template"
          },
          "templatePath": {
            "type": "string",
            "description": "File path to the ZPL template file",
            "example": "/templates/barcode_template.zpl"
          },
          "xOffset": {
            "type": "number",
            "format": "double",
            "description": "X-axis calibration offset in inches",
            "example": 0.0
          },
          "yOffset": {
            "type": "number",
            "format": "double",
            "description": "Y-axis calibration offset in inches",
            "example": 0.0
          }
        }
      },
      "PreviewResponse": {
        "type": "object",
        "description": "Successful response containing barcode preview image and navigation information",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates whether the preview generation was successful",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Success message describing the operation",
            "example": "Barcode preview generated successfully"
          },
          "selectedBarcodeIndex": {
            "type": "integer",
            "description": "The index of the newly selected barcode (after navigation)",
            "example": 1
          },
          "selectedBarcode": {
            "$ref": "#/components/schemas/BarcodeItem"
          },
          "previewImage": {
            "type": "string",
            "format": "byte",
            "description": "Base64-encoded preview image of the barcode label (PNG format)"
          },
          "previewImageMimeType": {
            "type": "string",
            "description": "MIME type of the preview image",
            "example": "image/png"
          },
          "navigationInfo": {
            "type": "object",
            "description": "Information about the navigation operation",
            "properties": {
              "totalItems": {
                "type": "integer",
                "description": "Total number of barcode items in the collection"
              },
              "previousIndex": {
                "type": "integer",
                "description": "The index before navigation"
              },
              "currentIndex": {
                "type": "integer",
                "description": "The index after navigation"
              },
              "isWrapped": {
                "type": "boolean",
                "description": "Indicates if navigation wrapped around (from first to last item)"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error response containing error details",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "Error message describing what went wrong"
          },
          "errorCode": {
            "type": "string",
            "description": "Error code for programmatic handling"
          },
          "details": {
            "type": "string",
            "description": "Additional error details for debugging"
          }
        }
      }
    }
  }
}
