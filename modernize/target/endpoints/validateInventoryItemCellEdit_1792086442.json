            "description": "The zero-based column index being edited",
            "minimum": 0
          },
          "newValue": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ],
            "description": "The new value entered in the cell"
          },
          "rowData": {
            "type": "object",
            "description": "Current row data for validation context",
            "properties": {
              "partNumber": {
                "type": "string"
              },
              "partDescription": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              },
              "barcode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "serialNumber": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reasonCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner": {
                "type": "string"
              },
              "warehouse": {
                "type": "string"
              },
              "purchaseOrderNumber": {
                "type": "string"
              },
              "removeNonCoded": {
                "type": "boolean"
              },
              "onHand": {
                "type": "integer"
              }
            },
            "required": [
              "partNumber",
              "quantity",
              "owner",
              "warehouse"
            ]
          }
        },
        "required": [
          "columnIndex",
          "newValue",
          "rowData"
        ]
      },
