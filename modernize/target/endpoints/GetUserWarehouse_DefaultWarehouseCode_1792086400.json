  "paths": {
    "/warehouses/default-warehouse-code": {
      "summary": "Get Default Warehouse Code",
      "description": "Retrieves the default warehouse code for the current user from the warehouses table",
      "get": {
        "tags": [
          "Warehouses"
        ],
        "summary": "Get Default Warehouse Code",
        "description": "Fetches the warehouse code marked as default (is_default = 1) from the warehouses table. This endpoint is used to determine the user's default warehouse for inventory operations.",
        "operationId": "GetUserWarehouse(Add Inventory.Forms.frmAddInventory.frmAddInventory.GetUserWarehouse.0)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successfully retrieved the default warehouse code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "warehouseCode": {
                      "type": "string",
                      "description": "The warehouse code of the default warehouse",
                      "example": "WH001"
                    },
                    "isDefault": {
                      "type": "boolean",
                      "description": "Indicates this is the default warehouse",
                      "example": true
                    }
                  },
                  "required": [
                    "warehouseCode"
                  ]
                },
                "example": {
                  "warehouseCode": "WH001",
                  "isDefault": true
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters or malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 400
                    }
                  }
                }
              }
            }
          },
          "401": {
