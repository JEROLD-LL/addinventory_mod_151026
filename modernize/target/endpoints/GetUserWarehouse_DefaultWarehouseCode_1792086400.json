                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    },
                    "statusCode": {
                      "type": "integer",
                      "example": 401
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - User does not have permission to access this resource",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    },
